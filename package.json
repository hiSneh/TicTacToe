{
  "name": "tictactoe-ecosystem",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform TicTacToe game ecosystem with React web and Expo mobile apps.",
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "npm --workspace @tictactoe/web run dev",
    "dev:mobile": "npm --workspace @tictactoe/mobile run start",
    "server": "bash scripts/server.sh",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "pm2": "^7.0.1",
    "prettier": "^3.5.3",
    "serve": "^14.2.6",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@types/react": "~19.0.10"
  }
}
